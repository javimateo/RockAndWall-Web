# Copia este archivo como .env para probar el chat en local (npm run dev).
# En Coolify se ponen en "Environment Variables".

# Clave de la API de Claude (console.anthropic.com). Sin ella el chat funciona en modo demo, con respuestas fijas.
ANTHROPIC_API_KEY=

# Modelo. Por defecto Claude Haiku 4.5: rápido y barato para preguntas cortas.
# CHAT_MODEL=claude-haiku-4-5-20251001

# Tope de mensajes al día para toda la web (para controlar el gasto). Por defecto 1500.
# CHAT_DAILY_LIMIT=1500
