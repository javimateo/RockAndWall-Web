---
/** Foto optimizada: AVIF con WebP de respaldo (sin PNG pesados). */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  widths?: number[];
  loading?: 'lazy' | 'eager';
  class?: string;
}

const { src, alt, sizes, widths = [480, 800, 1200, 1600], loading = 'lazy', class: className } = Astro.props;
const usable = widths.filter((w) => w <= src.width);
---

<Picture
  src={src}
  alt={alt}
  sizes={sizes}
  widths={usable.length ? usable : [src.width]}
  formats={['avif', 'webp']}
  fallbackFormat="webp"
  loading={loading}
  decoding="async"
  pictureAttributes={{ class: className }}
/>
