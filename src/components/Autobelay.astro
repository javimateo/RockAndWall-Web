---
/**
 * Indicador de lectura con forma de autoasegurador: la cinta azul baja
 * desde el aparato a medida que bajas por la página, con el mosquetón al final.
 */
---

<div class="autobelay" aria-hidden="true">
  <span class="autobelay__device"></span>
  <span class="autobelay__strap"></span>
  <svg class="autobelay__biner" viewBox="0 0 24 40">
    <path d="M12 2c5 0 8 3 8 8v16c0 7-4 12-8 12s-8-5-8-12V10c0-5 3-8 8-8Z" fill="none" stroke="#1b1d21" stroke-width="3.2"></path>
    <path d="M4 12v10" stroke="#9aa1a8" stroke-width="3.4" stroke-linecap="round"></path>
    <rect x="15.5" y="14" width="5" height="9" rx="1.5" fill="#e33b2c"></rect>
  </svg>
</div>

<script>
  const root = document.querySelector<HTMLElement>('.autobelay');
  if (root) {
    let ticking = false;
    const update = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      root.style.setProperty('--p', String(max > 0 ? Math.min(1, scrollY / max) : 0));
      ticking = false;
    };
    addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true }
    );
    addEventListener('resize', update);
    update();
  }
</script>

<style>
  .autobelay {
    --p: 0;
    --len: calc(var(--p) * (100dvh - 150px) + 24px);
    position: fixed;
    top: 0;
    right: 18px;
    z-index: 40;
    width: 24px;
    pointer-events: none;
  }

  .autobelay__device {
    position: absolute;
    top: 0;
    left: 50%;
    translate: -50% 0;
    width: 20px;
    height: 16px;
    border-radius: 0 0 8px 8px;
    background: linear-gradient(180deg, #4b5159, #23272d);
    box-shadow: 0 2px 4px rgb(0 0 0 / 0.3);
  }

  .autobelay__strap {
    position: absolute;
    top: 12px;
    left: 50%;
    translate: -50% 0;
    width: 7px;
    height: var(--len);
    border-radius: 2px;
    background:
      repeating-linear-gradient(180deg, rgb(255 255 255 / 0.18) 0 2px, transparent 2px 7px),
      linear-gradient(90deg, #135ca8, var(--blue) 50%, #135ca8);
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.08);
  }

  .autobelay__biner {
    position: absolute;
    top: calc(var(--len) + 8px);
    left: 50%;
    width: 16px;
    translate: -50% 0;
    rotate: 6deg;
    filter: drop-shadow(0 2px 2px rgb(0 0 0 / 0.3));
  }

  @media (max-width: 900px) {
    .autobelay {
      display: none;
    }
  }
</style>
