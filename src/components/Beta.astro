---
/**
 * "La beta": foto real con las presas marcadas a rotulador y la secuencia dibujada,
 * como cuando alguien te explica un bloque señalando la pared.
 * Las coordenadas van en píxeles de la foto original.
 *
 * Círculos, línea y números van en un único SVG con las mismas medidas que la foto, así siempre
 * coinciden con las presas. Con `fill`, la foto rellena la altura de su contenedor y se recorta
 * por abajo (y por los lados si hace falta) sin que las marcas se muevan.
 */
import type { ImageMetadata } from 'astro';
import Foto from './Foto.astro';
import { markerCircle, routeLine } from '../lib/draw';

type Kind = 'start' | 'hand' | 'foot' | 'top';
interface Point {
  x: number;
  y: number;
  r?: number;
  kind: Kind;
  n?: number | string;
}
interface Props {
  image: ImageMetadata;
  alt: string;
  points: Point[];
  sizes?: string;
  /** Píxeles de la foto original que se recortan por abajo (sin `fill`) */
  cropBottom?: number;
  /** Rellenar la altura del contenedor en vez de usar la proporción de la foto */
  fill?: boolean;
  class?: string;
}

const {
  image,
  alt,
  points,
  sizes = '(min-width: 900px) 45vw, 100vw',
  cropBottom = 0,
  fill = false,
  class: className,
} = Astro.props;
const W = image.width;
const H = fill ? image.height : image.height - cropBottom;
const unit = W / 100;

const marks = points.map((p, i) => ({
  ...p,
  d: markerCircle(p.x, p.y, (p.r ?? 5.2) * unit, i + 1),
}));

const sequence = points.filter((p) => p.kind !== 'foot').map((p) => [p.x, p.y] as [number, number]);
const line = sequence.length > 1 ? routeLine(sequence, 11) : '';
const numbered = marks.filter((m) => m.n !== undefined);
---

<figure
  class:list={['beta', className]}
  data-reveal
  data-fill={fill ? '' : undefined}
  style={fill ? undefined : `aspect-ratio:${W}/${H}`}
>
  <Foto src={image} alt={alt} sizes={sizes} widths={[480, 800, 1080]} class="beta__img" />
  <svg
    class="beta__svg"
    viewBox={`0 0 ${W} ${H}`}
    preserveAspectRatio={fill ? 'xMidYMin slice' : 'xMidYMid meet'}
    aria-hidden="true"
  >
    {line && <path class="beta__line" d={line} pathLength="1" stroke-width={unit * 0.7} />}
    {
      marks.map((m, i) => (
        <g class="beta__mark" data-kind={m.kind} style={`--i:${i}`}>
          <path d={m.d} pathLength="1" stroke-width={unit * (m.kind === 'foot' ? 0.6 : 0.85)} />
        </g>
      ))
    }
    {
      numbered.map((m, i) => (
        <g transform={`translate(${(m.x + 5.8 * unit).toFixed(1)} ${(m.y - 4.4 * unit).toFixed(1)})`}>
          <g class="beta__num" data-kind={m.kind} style={`--i:${i}`}>
            <circle r={unit * 2.9} />
            <text text-anchor="middle" dy="0.36em" font-size={unit * (String(m.n).length > 2 ? 2 : 2.9)}>
              {m.n}
            </text>
          </g>
        </g>
      ))
    }
  </svg>
</figure>

<style>
  .beta {
    --start: var(--led-start);
    --hand: #ffe14a;
    --foot: var(--led-foot);
    --top: var(--led-top);
    position: relative;
    margin: 0;
    overflow: hidden;
    background: var(--wall-3);
  }

  /* Proporción de la foto: ocupa el ancho y lo que sobra se corta por abajo (cropBottom) */
  .beta :global(.beta__img),
  .beta :global(.beta__img img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Relleno: la foto cubre el contenedor anclada arriba, igual que el SVG (xMidYMin slice) */
  .beta[data-fill] {
    height: 100%;
  }

  .beta[data-fill] :global(.beta__img),
  .beta[data-fill] :global(.beta__img img) {
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
  }

  .beta__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .beta__svg path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.9s var(--ease-out);
  }

  .beta__line {
    stroke: #fff;
    stroke-dasharray: 0.012 0.018 !important;
    stroke-dashoffset: 0 !important;
    opacity: 0;
    filter: drop-shadow(0 0 3px rgb(0 0 0 / 0.55));
    transition: opacity 1.2s var(--ease-out) 0.9s;
  }

  .beta__mark path {
    stroke: var(--hand);
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.5));
    transition-delay: calc(var(--i) * 0.16s);
  }

  .beta__mark[data-kind='start'] path { stroke: var(--start); }
  .beta__mark[data-kind='foot'] path { stroke: var(--foot); }
  .beta__mark[data-kind='top'] path { stroke: var(--top); }

  .beta__num {
    transform: scale(0);
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.5s var(--ease-spring);
    transition-delay: calc(0.3s + var(--i) * 0.16s);
  }

  .beta__num circle {
    fill: var(--hand);
    filter: drop-shadow(0 2px 3px rgb(0 0 0 / 0.35));
  }

  .beta__num text {
    fill: var(--ink);
    font-family: var(--f-hand);
  }

  .beta__num[data-kind='start'] circle { fill: var(--start); }
  .beta__num[data-kind='top'] circle { fill: var(--top); }
  .beta__num[data-kind='top'] text { fill: #fff; }

  .beta:global(.is-in) .beta__svg path {
    stroke-dashoffset: 0;
  }
  .beta:global(.is-in) .beta__line {
    opacity: 1;
  }
  .beta:global(.is-in) .beta__num {
    transform: scale(1);
  }
</style>
