---
/**
 * "La beta": foto real con las presas marcadas a rotulador y la secuencia dibujada,
 * como cuando alguien te explica un bloque señalando la pared.
 * Las coordenadas van en píxeles de la foto original.
 */
import type { ImageMetadata } from 'astro';
import Foto from './Foto.astro';
import { markerCircle, routeLine } from '../lib/draw';

type Kind = 'start' | 'hand' | 'foot' | 'top';
interface Point {
  x: number;
  y: number;
  r?: number;
  kind: Kind;
  n?: number | string;
}
interface Note {
  x: number;
  y: number;
  text: string;
  to: [number, number];
  align?: 'left' | 'right';
}
interface Props {
  image: ImageMetadata;
  alt: string;
  points: Point[];
  notes?: Note[];
  sizes?: string;
  /** Píxeles de la foto original que se recortan por abajo */
  cropBottom?: number;
  class?: string;
}

const { image, alt, points, notes = [], sizes = '(min-width: 900px) 45vw, 100vw', cropBottom = 0, class: className } = Astro.props;
const W = image.width;
const H = image.height - cropBottom;
const unit = W / 100;

const marks = points.map((p, i) => ({
  ...p,
  d: markerCircle(p.x, p.y, (p.r ?? 5.2) * unit, i + 1),
}));

const sequence = points.filter((p) => p.kind !== 'foot').map((p) => [p.x, p.y] as [number, number]);
const line = sequence.length > 1 ? routeLine(sequence, 11) : '';

const arrows = notes.map((n, i) => {
  const [tx, ty] = n.to;
  const mx = (n.x + tx) / 2 + (i % 2 ? 1 : -1) * 4 * unit;
  const my = (n.y + ty) / 2 - 3 * unit;
  const ang = Math.atan2(ty - my, tx - mx);
  const head = 2.6 * unit;
  const hx1 = tx - Math.cos(ang - 0.5) * head;
  const hy1 = ty - Math.sin(ang - 0.5) * head;
  const hx2 = tx - Math.cos(ang + 0.5) * head;
  const hy2 = ty - Math.sin(ang + 0.5) * head;
  return {
    d: `M${n.x} ${n.y} Q${mx} ${my} ${tx} ${ty} M${hx1.toFixed(1)} ${hy1.toFixed(1)} L${tx} ${ty} L${hx2.toFixed(1)} ${hy2.toFixed(1)}`,
    left: (n.x / W) * 100,
    top: (n.y / H) * 100,
    ...n,
  };
});
---

<figure class:list={['beta', className]} data-reveal style={`aspect-ratio:${W}/${H}`}>
  <Foto src={image} alt={alt} sizes={sizes} widths={[480, 800, 1080]} class="beta__img" />
  <svg class="beta__svg" viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
    {line && <path class="beta__line" d={line} pathLength="1" stroke-width={unit * 0.7} />}
    {
      marks.map((m, i) => (
        <g class="beta__mark" data-kind={m.kind} style={`--i:${i}`}>
          <path d={m.d} pathLength="1" stroke-width={unit * (m.kind === 'foot' ? 0.6 : 0.85)} />
        </g>
      ))
    }
  </svg>
  {
    marks
      .filter((m) => m.n !== undefined)
      .map((m, i) => (
        <span
          class="beta__num"
          data-kind={m.kind}
          style={`left:${(m.x / W) * 100}%;top:${(m.y / H) * 100}%;--i:${i}`}
          aria-hidden="true"
        >
          {m.n}
        </span>
      ))
  }
  {
    arrows.length > 0 && (
      <svg class="beta__svg beta__svg--notes" viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
        {arrows.map((a, i) => (
          <path class="beta__arrow" d={a.d} pathLength="1" stroke-width={unit * 0.5} style={`--i:${i}`} />
        ))}
      </svg>
    )
  }
  {
    arrows.map((a, i) => (
      <span class="beta__note" data-align={a.align ?? 'left'} style={`left:${a.left}%;top:${a.top}%;--i:${i}`}>
        {a.text}
      </span>
    ))
  }
</figure>

<style>
  .beta {
    --start: var(--led-start);
    --hand: #ffe14a;
    --foot: var(--led-foot);
    --top: var(--led-top);
    position: relative;
    margin: 0;
    overflow: hidden;
    background: var(--wall-3);
  }

  .beta :global(.beta__img),
  .beta :global(.beta__img img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
  }

  .beta__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .beta__svg path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.9s var(--ease-out);
  }

  .beta__line {
    stroke: #fff;
    stroke-dasharray: 0.012 0.018 !important;
    stroke-dashoffset: 0 !important;
    opacity: 0;
    filter: drop-shadow(0 0 3px rgb(0 0 0 / 0.55));
    transition: opacity 1.2s var(--ease-out) 0.9s;
  }

  .beta__mark path {
    stroke: var(--hand);
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.5));
    transition-delay: calc(var(--i) * 0.16s);
  }

  .beta__mark[data-kind='start'] path { stroke: var(--start); }
  .beta__mark[data-kind='foot'] path { stroke: var(--foot); }
  .beta__mark[data-kind='top'] path { stroke: var(--top); }

  .beta__num {
    position: absolute;
    translate: -50% -50%;
    margin-left: 5.8%;
    margin-top: -4.4%;
    display: grid;
    place-items: center;
    width: 1.9em;
    height: 1.9em;
    border-radius: 50%;
    background: var(--hand);
    color: var(--ink);
    font-family: var(--f-hand);
    font-size: clamp(0.8rem, 0.6rem + 0.6vw, 1.1rem);
    line-height: 1;
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.35);
    scale: 0;
    transition: scale 0.5s var(--ease-spring);
    transition-delay: calc(0.3s + var(--i) * 0.16s);
  }

  .beta__num[data-kind='start'] { background: var(--start); }
  .beta__num[data-kind='top'] { background: var(--top); color: #fff; }

  .beta__arrow {
    stroke: #fff;
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.6));
    transition-delay: calc(1.1s + var(--i) * 0.3s) !important;
  }

  .beta__note {
    position: absolute;
    translate: -50% -110%;
    padding: 0.35em 0.7em 0.3em;
    background: var(--ink);
    color: #fff;
    font-family: var(--f-hand);
    font-size: clamp(0.9rem, 0.7rem + 0.6vw, 1.25rem);
    line-height: 1.1;
    white-space: nowrap;
    rotate: -4deg;
    opacity: 0;
    transition: opacity 0.4s var(--ease-out);
    transition-delay: calc(1s + var(--i) * 0.3s);
  }

  .beta:global(.is-in) .beta__svg path {
    stroke-dashoffset: 0;
  }
  .beta:global(.is-in) .beta__line {
    opacity: 1;
  }
  .beta:global(.is-in) .beta__num {
    scale: 1;
  }
  .beta:global(.is-in) .beta__note {
    opacity: 1;
  }
</style>
