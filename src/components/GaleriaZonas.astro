---
/**
 * Visita por zonas: una foto grande y la lista de zonas al lado.
 * Al cambiar de zona, una banda azul en diagonal (como las pintadas en la pared) barre la foto
 * y descubre la siguiente. Avanza sola, se pausa al interactuar o fuera de pantalla,
 * y se puede deslizar con el dedo o usar las flechas del teclado.
 */
import type { ImageMetadata } from 'astro';
import Foto from './Foto.astro';

interface Item {
  img: ImageMetadata;
  alt: string;
  caption: string;
}
interface Props {
  items: Item[];
  label: string;
  interval?: number;
  class?: string;
}

const { items, label, interval = 5500, class: className } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
const uid = `gz${Math.random().toString(36).slice(2, 7)}`;
---

<div class:list={['gz', className]} data-galeria data-interval={interval} style={`--interval:${interval}ms`}>
  <div class="container gz__grid">
    <div class="gz__stage">
      {
        items.map((it, i) => (
          <div
            class:list={['gz__slide', { 'is-active': i === 0 }]}
            id={`${uid}-p${i}`}
            role="tabpanel"
            aria-labelledby={`${uid}-t${i}`}
            aria-hidden={i === 0 ? undefined : 'true'}
          >
            <div class="gz__zoom">
              <Foto src={it.img} alt={it.alt} sizes="(min-width: 900px) 64vw, 100vw" widths={[640, 960, 1280, 1600]} />
            </div>
            <p class="gz__cap" aria-hidden="true">{it.alt}</p>
          </div>
        ))
      }
      <span class="gz__band" aria-hidden="true"></span>
      <div class="gz__hud">
        <p class="gz__count" aria-hidden="true">
          <strong data-current>01</strong> / {pad(items.length)}
        </p>
        <button type="button" class="gz__btn" data-dir="-1" aria-label="Zona anterior">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M19 12H6M11 6.5 5.5 12 11 17.5"></path></svg>
        </button>
        <button type="button" class="gz__btn" data-dir="1" aria-label="Zona siguiente">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12h13M13 6.5 18.5 12 13 17.5"></path></svg>
        </button>
      </div>
    </div>

    <div class="gz__list" role="tablist" aria-label={label}>
      {
        items.map((it, i) => (
          <button
            type="button"
            class="gz__tab"
            role="tab"
            id={`${uid}-t${i}`}
            aria-controls={`${uid}-p${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            <span class="gz__n">{pad(i + 1)}</span>
            <span class="gz__t">{it.caption}</span>
            <span class="gz__timer" aria-hidden="true"></span>
          </button>
        ))
      }
    </div>
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-galeria]')) {
    const stage = root.querySelector<HTMLElement>('.gz__stage')!;
    const band = root.querySelector<HTMLElement>('.gz__band')!;
    const list = root.querySelector<HTMLElement>('.gz__list')!;
    const counter = root.querySelector<HTMLElement>('[data-current]')!;
    const slides = [...root.querySelectorAll<HTMLElement>('.gz__slide')];
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.gz__tab')];
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const interval = Number(root.dataset.interval) || 5500;
    const n = slides.length;
    let cur = 0;

    /** Deja la pestaña activa a la vista dentro de la lista (en móvil es una fila que se desliza) */
    const reveal = (tab: HTMLElement) => {
      if (list.scrollWidth <= list.clientWidth) return;
      const pad = parseFloat(getComputedStyle(list).paddingLeft) || 0;
      const left = list.scrollLeft + tab.getBoundingClientRect().left - list.getBoundingClientRect().left - pad;
      list.scrollTo({ left, behavior: reduced ? 'auto' : 'smooth' });
    };

    const show = (i: number, dir = i > cur ? 1 : -1) => {
      i = (i + n) % n;
      if (i === cur) return;
      const prev = slides[cur];
      const next = slides[i];
      for (const s of slides) s.classList.remove('is-prev');
      prev.classList.remove('is-active');
      prev.classList.add('is-prev');
      prev.setAttribute('aria-hidden', 'true');
      stage.dataset.dir = dir > 0 ? 'fwd' : 'back';
      // Reinicia las animaciones de entrada (foto y banda)
      band.classList.remove('is-run');
      void stage.offsetWidth;
      band.classList.add('is-run');
      next.classList.add('is-active');
      next.removeAttribute('aria-hidden');

      tabs[cur].setAttribute('aria-selected', 'false');
      tabs[cur].tabIndex = -1;
      tabs[i].setAttribute('aria-selected', 'true');
      tabs[i].tabIndex = 0;
      counter.textContent = String(i + 1).padStart(2, '0');
      reveal(tabs[i]);
      cur = i;
      restartTimer();
    };

    /* ---------- Avance automático ---------- */
    let timer = 0;
    let resumeAt = 0;
    let visible = false;
    let paused = false;

    function restartTimer() {
      clearTimeout(timer);
      root.classList.remove('is-timing');
      if (reduced || !visible || paused || document.hidden) return;
      void root.offsetWidth;
      root.classList.add('is-timing');
      timer = window.setTimeout(() => show(cur + 1, 1), interval);
    }
    const pause = (ms = 0) => {
      paused = true;
      clearTimeout(timer);
      clearTimeout(resumeAt);
      root.classList.remove('is-timing');
      if (ms) resumeAt = window.setTimeout(() => ((paused = false), restartTimer()), ms);
    };
    const resume = () => {
      paused = false;
      restartTimer();
    };

    new IntersectionObserver(
      ([e]) => {
        visible = e.isIntersecting;
        restartTimer();
      },
      { threshold: 0.4 }
    ).observe(stage);
    document.addEventListener('visibilitychange', restartTimer);
    root.addEventListener('mouseenter', () => pause());
    root.addEventListener('mouseleave', resume);
    root.addEventListener('focusin', () => pause());
    root.addEventListener('focusout', (e) => {
      if (!root.contains(e.relatedTarget as Node)) resume();
    });

    /* ---------- Controles ---------- */
    tabs.forEach((t, i) => t.addEventListener('click', () => show(i)));
    root.querySelectorAll<HTMLButtonElement>('.gz__btn').forEach((b) =>
      b.addEventListener('click', () => {
        const d = Number(b.dataset.dir);
        show(cur + d, d);
      })
    );
    list.addEventListener('keydown', (e) => {
      const k = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[e.key];
      if (!k && e.key !== 'Home' && e.key !== 'End') return;
      e.preventDefault();
      const i = e.key === 'Home' ? 0 : e.key === 'End' ? n - 1 : cur + k!;
      show(i, k ?? (i > cur ? 1 : -1));
      tabs[cur].focus();
    });

    /* ---------- Deslizar la foto (dedo o ratón) ---------- */
    let x0 = 0;
    let y0 = 0;
    let down = false;
    stage.addEventListener('pointerdown', (e) => {
      if ((e.target as HTMLElement).closest('button')) return;
      down = true;
      x0 = e.clientX;
      y0 = e.clientY;
      if (e.pointerType !== 'mouse') pause(8000);
    });
    addEventListener('pointerup', (e) => {
      if (!down) return;
      down = false;
      const dx = e.clientX - x0;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(e.clientY - y0)) show(cur + (dx < 0 ? 1 : -1), dx < 0 ? 1 : -1);
    });
    stage.addEventListener('dragstart', (e) => e.preventDefault());
  }
</script>

<style>
  .gz {
    --stage-ar: 4 / 3;
    --slant: 18%;
    --wipe: 0.95s;
    --wipe-ease: cubic-bezier(0.72, 0, 0.18, 1);
  }

  .gz__grid {
    display: grid;
    gap: 20px;
  }

  @media (min-width: 900px) {
    .gz {
      --stage-ar: 16 / 10;
    }
    .gz__grid {
      grid-template-columns: minmax(230px, 0.36fr) 1fr;
      grid-template-areas: 'list stage';
      gap: clamp(28px, 4vw, 64px);
      align-items: stretch;
    }
    .gz__stage {
      grid-area: stage;
    }
    .gz__list {
      grid-area: list;
    }
  }

  /* ---------- Escenario ---------- */
  .gz__stage {
    position: relative;
    aspect-ratio: var(--stage-ar);
    overflow: hidden;
    background: var(--ink);
    touch-action: pan-y;
    user-select: none;
  }

  @media (max-width: 899px) {
    .gz__stage {
      margin-inline: calc(var(--gutter) * -1);
    }
  }

  .gz__slide {
    position: absolute;
    inset: 0;
    margin: 0;
    visibility: hidden;
  }

  .gz__slide.is-prev {
    z-index: 1;
    visibility: visible;
  }

  .gz__slide.is-active {
    z-index: 3;
    visibility: visible;
  }

  .gz__zoom,
  .gz__zoom :global(picture),
  .gz__zoom :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .gz__zoom :global(img) {
    object-fit: cover;
    pointer-events: none;
  }

  /* Zoom lento: sigue corriendo mientras la foto sale, así no da saltos */
  .is-active .gz__zoom,
  .is-prev .gz__zoom {
    animation: gz-kb calc(var(--interval) + var(--wipe) + 1.5s) linear both;
  }

  @keyframes gz-kb {
    from { transform: scale(1.02); }
    to { transform: scale(1.09); }
  }

  /* Entrada: la foto nueva se descubre con un borde en diagonal y la banda azul va por delante */
  .gz__stage[data-dir] .gz__slide.is-active {
    animation: gz-in-fwd var(--wipe) var(--wipe-ease) 0.06s both;
  }

  .gz__stage[data-dir='back'] .gz__slide.is-active {
    animation-name: gz-in-back;
  }

  .gz__band {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: var(--blue);
    visibility: hidden;
  }

  .gz__band.is-run {
    visibility: visible;
    animation: gz-in-fwd var(--wipe) var(--wipe-ease) both;
  }

  .gz__stage[data-dir='back'] .gz__band.is-run {
    animation-name: gz-in-back;
  }

  @keyframes gz-in-fwd {
    from { clip-path: polygon(0 0, 0 0, calc(var(--slant) * -1) 100%, calc(var(--slant) * -1) 100%); }
    to { clip-path: polygon(0 0, calc(100% + var(--slant)) 0, 100% 100%, calc(var(--slant) * -1) 100%); }
  }

  @keyframes gz-in-back {
    from { clip-path: polygon(calc(100% + var(--slant)) 0, calc(100% + var(--slant)) 0, 100% 100%, 100% 100%); }
    to { clip-path: polygon(0 0, calc(100% + var(--slant)) 0, 100% 100%, calc(var(--slant) * -1) 100%); }
  }

  /* La foto que sale se desplaza un poco hacia el lado contrario */
  .gz__stage[data-dir] .gz__slide.is-prev {
    animation: gz-out-fwd var(--wipe) var(--wipe-ease) 0.06s both;
  }

  .gz__stage[data-dir='back'] .gz__slide.is-prev {
    animation-name: gz-out-back;
  }

  @keyframes gz-out-fwd {
    to { translate: -6% 0; filter: brightness(0.6); }
  }

  @keyframes gz-out-back {
    to { translate: 6% 0; filter: brightness(0.6); }
  }

  .gz__cap {
    position: absolute;
    left: 0;
    bottom: 0;
    max-width: min(34rem, 70%);
    padding: 12px 18px;
    background: var(--ink);
    color: #fff;
    font-size: 0.92rem;
    line-height: 1.35;
    opacity: 0;
    translate: 0 100%;
    transition: opacity 0.4s, translate 0.6s var(--ease-out);
  }

  .gz__slide.is-active .gz__cap {
    opacity: 1;
    translate: 0 0;
    transition-delay: calc(var(--wipe) * 0.8);
  }

  @media (max-width: 899px) {
    .gz__cap {
      display: none;
    }
  }

  .gz__hud {
    position: absolute;
    right: 0;
    bottom: 0;
    z-index: 4;
    display: flex;
    align-items: center;
    background: var(--ink);
    color: #fff;
  }

  .gz__count {
    padding: 0 16px;
    color: rgb(255 255 255 / 0.6);
    font-family: var(--f-display);
    font-stretch: 125%;
    font-weight: 700;
    font-size: 0.76rem;
    letter-spacing: 0.06em;
  }

  .gz__count strong {
    color: #fff;
  }

  .gz__btn {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 0;
    border-left: 1px solid rgb(255 255 255 / 0.14);
    background: transparent;
    color: #fff;
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .gz__btn:hover {
    background: var(--blue-deep);
  }

  .gz__btn:focus-visible {
    outline-offset: -3px;
  }

  .gz__btn svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ---------- Lista de zonas ---------- */
  .gz__list {
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-top: 1px solid rgb(18 20 23 / 0.14);
  }

  .gz__tab {
    position: relative;
    display: grid;
    grid-template-columns: 2.6em 1fr;
    align-items: baseline;
    gap: 8px;
    padding: 13px 0;
    border: 0;
    border-bottom: 1px solid rgb(18 20 23 / 0.14);
    background: none;
    color: var(--ink-3);
    text-align: left;
    cursor: pointer;
    transition: color 0.25s, padding-left 0.4s var(--ease-out);
  }

  .gz__tab:hover {
    color: var(--ink);
  }

  .gz__tab[aria-selected='true'] {
    padding-left: 10px;
    color: var(--ink);
  }

  .gz__n {
    font-family: var(--f-display);
    font-stretch: 125%;
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
  }

  .gz__tab[aria-selected='true'] .gz__n {
    color: var(--blue-deep);
  }

  .gz__t {
    font-family: var(--f-display);
    font-stretch: 80%;
    font-weight: 800;
    font-size: clamp(1.05rem, 0.8rem + 0.6vw, 1.4rem);
    line-height: 1.05;
    text-transform: uppercase;
  }

  /* Tiempo hasta la siguiente zona, sobre la línea de la pestaña activa */
  .gz__timer {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 3px;
    background: var(--blue-deep);
    transform-origin: 0 50%;
    transform: scaleX(0);
  }

  .gz__tab[aria-selected='true'] .gz__timer {
    transform: scaleX(1);
    transition: transform 0.5s var(--ease-out);
  }

  .gz.is-timing .gz__tab[aria-selected='true'] .gz__timer {
    transition: none;
    animation: gz-timer var(--interval) linear both;
  }

  @keyframes gz-timer {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  /* En móvil la lista es una fila que se desliza bajo la foto */
  @media (max-width: 899px) {
    .gz__list {
      flex-direction: row;
      justify-content: flex-start;
      gap: 20px;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      overflow-x: auto;
      border-top: 0;
      scrollbar-width: none;
    }
    .gz__list::-webkit-scrollbar {
      display: none;
    }
    .gz__tab {
      flex: none;
      grid-template-columns: auto auto;
      padding: 10px 0 12px;
    }
    .gz__tab[aria-selected='true'] {
      padding-left: 0;
    }
    .gz__t {
      font-size: 1rem;
      white-space: nowrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .is-active .gz__zoom,
    .is-prev .gz__zoom {
      animation: none;
    }
    .gz__stage[data-dir] .gz__slide.is-active {
      animation: gz-fade 0.3s both;
    }
    .gz__stage[data-dir] .gz__slide.is-prev,
    .gz__band.is-run {
      animation: none;
      visibility: hidden;
    }
    @keyframes gz-fade {
      from { opacity: 0; }
    }
  }
</style>
