---
/**
 * Pie de página en forma de colchoneta: vinilo gris acolchado con costuras,
 * etiqueta cosida y marcas de magnesio. Al llegar, "amortigua" la caída.
 */
---

<footer class="pad" data-reveal>
  <div class="pad__mat">
    <span class="pad__label" aria-hidden="true">Rock &amp; Wall · Sevilla</span>
    <span class="pad__chalk pad__chalk--a" aria-hidden="true"></span>
    <span class="pad__chalk pad__chalk--b" aria-hidden="true"></span>
    <div class="pad__content container">
      <slot />
    </div>
  </div>
</footer>

<style>
  .pad {
    position: relative;
    padding-top: 36px;
    background: var(--wall-2);
  }

  .pad__mat {
    --panel: 25%;
    position: relative;
    overflow: hidden;
    color: #fff;
    border-radius: 34px 34px 0 0;
    background:
      repeating-linear-gradient(90deg, transparent 0 calc(var(--panel) - 2px), rgb(0 0 0 / 0.22) calc(var(--panel) - 2px) var(--panel)),
      linear-gradient(90deg, rgb(0 0 0 / 0.2), rgb(255 255 255 / 0.05) 9%, rgb(255 255 255 / 0.1) 50%, rgb(255 255 255 / 0.04) 91%, rgb(0 0 0 / 0.2)) 0 0 / var(--panel) 100%,
      linear-gradient(180deg, rgb(255 255 255 / 0.1), transparent 30%, rgb(0 0 0 / 0.14)),
      var(--grain),
      var(--pad);
    box-shadow:
      inset 0 9px 0 rgb(255 255 255 / 0.13),
      inset 0 16px 20px -12px rgb(0 0 0 / 0.25),
      0 -20px 40px -22px rgb(0 0 0 / 0.45);
    transform-origin: 50% 100%;
  }

  /* Costura pespunteada a lo largo del borde superior */
  .pad__mat::before {
    content: '';
    position: absolute;
    top: 18px;
    left: 26px;
    right: 26px;
    border-top: 2px dashed rgb(255 255 255 / 0.22);
  }

  .pad:global(.is-in) .pad__mat {
    animation: squish 0.9s var(--ease-out) both;
  }

  @keyframes squish {
    0% { transform: scaleY(1); }
    22% { transform: scaleY(0.965) scaleX(1.006); }
    55% { transform: scaleY(1.012); }
    100% { transform: scaleY(1); }
  }

  .pad__label {
    position: absolute;
    top: 38px;
    right: clamp(24px, 6vw, 90px);
    padding: 6px 12px;
    border: 1.5px dashed rgb(255 255 255 / 0.45);
    border-radius: 3px;
    background: var(--ink);
    font-family: var(--f-display);
    font-stretch: 85%;
    font-weight: 750;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    rotate: 1.5deg;
  }

  .pad__chalk {
    position: absolute;
    width: 180px;
    height: 110px;
    background: var(--chalk);
    background-size: 70px;
    mask: radial-gradient(closest-side, #000 20%, transparent 100%);
    opacity: 0.55;
    pointer-events: none;
  }

  .pad__chalk--a { left: 8%; bottom: 18%; rotate: -12deg; }
  .pad__chalk--b { right: 22%; top: 30%; width: 120px; height: 80px; rotate: 20deg; opacity: 0.4; }

  .pad__content {
    position: relative;
    padding-block: clamp(80px, 10vw, 130px) 40px;
  }

  @media (max-width: 700px) {
    .pad__mat {
      --panel: 50%;
    }
    .pad__label {
      display: none;
    }
  }
</style>
