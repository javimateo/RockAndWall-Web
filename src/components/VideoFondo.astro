---
/**
 * Vídeo que rellena su contenedor: primero se ve la imagen optimizada y el vídeo
 * se carga cuando la página ya ha terminado (scripts/videos.ts), apareciendo con un fundido.
 */
import type { ImageMetadata } from 'astro';
import Foto from './Foto.astro';

interface Props {
  poster: ImageMetadata;
  alt: string;
  src: string;
  srcSm?: string;
  sizes?: string;
  class?: string;
}

const { poster, alt, src, srcSm, sizes = '100vw', class: className } = Astro.props;
---

<div class:list={['vf', className]}>
  <Foto src={poster} alt={alt} sizes={sizes} widths={[640, 960, 1280, 1920]} priority />
  <video muted loop playsinline preload="none" data-hero data-src={src} data-src-sm={srcSm} aria-hidden="true"></video>
</div>

<style>
  .vf {
    position: relative;
    overflow: hidden;
    background: #1b1d21;
  }

  .vf :global(picture),
  .vf :global(img),
  .vf video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vf video {
    opacity: 0;
    transition: opacity 0.9s var(--ease-out);
  }

  .vf video:global(.is-playing) {
    opacity: 1;
  }
</style>
