---
/**
 * Carrusel horizontal de fotos a sangre: se arrastra con ratón o dedo, tiene flechas
 * y barra de progreso, y cada foto se desplaza un poco dentro de su marco (paralaje).
 */
import type { ImageMetadata } from 'astro';
import Foto from './Foto.astro';

interface Item {
  img: ImageMetadata;
  alt: string;
  caption: string;
}
interface Props {
  items: Item[];
  label: string;
  class?: string;
}

const { items, label, class: className } = Astro.props;
---

<div class:list={['car', className]} data-carrusel>
  <div class="car__track" tabindex="0" role="region" aria-label={label}>
    {
      items.map((it, i) => (
        <figure class="car__item" style={`--ar:${(it.img.width / it.img.height).toFixed(3)};--i:${i}`}>
          <Foto src={it.img} alt={it.alt} sizes="(min-width: 900px) 60vw, 90vw" widths={[640, 960, 1280]} />
          <figcaption>{it.caption}</figcaption>
        </figure>
      ))
    }
  </div>
  <div class="container car__ui">
    <div class="car__bar" aria-hidden="true"><span></span></div>
    <div class="car__btns">
      <button type="button" class="car__btn" data-dir="-1" aria-label="Foto anterior">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M19 12H6M11 6.5 5.5 12 11 17.5"></path></svg>
      </button>
      <button type="button" class="car__btn" data-dir="1" aria-label="Foto siguiente">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12h13M13 6.5 18.5 12 13 17.5"></path></svg>
      </button>
    </div>
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-carrusel]')) {
    const track = root.querySelector<HTMLElement>('.car__track')!;
    const bar = root.querySelector<HTMLElement>('.car__bar span')!;
    const items = [...track.querySelectorAll<HTMLElement>('.car__item')];
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    let ticking = false;
    const update = () => {
      ticking = false;
      const max = track.scrollWidth - track.clientWidth;
      bar.style.transform = `scaleX(${max > 0 ? Math.max(0.08, track.scrollLeft / max) : 1})`;
      if (reduced) return;
      const mid = innerWidth / 2;
      for (const it of items) {
        const r = it.getBoundingClientRect();
        if (r.right < 0 || r.left > innerWidth) continue;
        const p = (r.left + r.width / 2 - mid) / innerWidth;
        it.style.setProperty('--p', p.toFixed(3));
      }
    };
    const request = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    track.addEventListener('scroll', request, { passive: true });
    addEventListener('resize', request);
    update();

    const pos = (it: HTMLElement) => it.offsetLeft - items[0].offsetLeft;
    const step = (dir: number) => {
      const current = items.find((it) => pos(it) + it.offsetWidth / 2 > track.scrollLeft + 2) ?? items[0];
      const i = Math.min(items.length - 1, Math.max(0, items.indexOf(current) + dir));
      track.scrollTo({ left: pos(items[i]), behavior: reduced ? 'auto' : 'smooth' });
    };
    root.querySelectorAll<HTMLButtonElement>('.car__btn').forEach((b) =>
      b.addEventListener('click', () => step(Number(b.dataset.dir)))
    );
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        e.preventDefault();
        step(e.key === 'ArrowRight' ? 1 : -1);
      }
    });

    // Arrastre con ratón (en táctil ya lo hace el navegador)
    let startX = 0;
    let startLeft = 0;
    let dragging = false;
    let moved = false;
    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      dragging = true;
      moved = false;
      startX = e.clientX;
      startLeft = track.scrollLeft;
    });
    addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - startX;
      if (!moved && Math.abs(dx) > 4) {
        moved = true;
        track.classList.add('is-dragging');
      }
      if (moved) track.scrollLeft = startLeft - dx;
    });
    addEventListener('pointerup', () => {
      if (!dragging) return;
      dragging = false;
      if (moved) {
        track.classList.remove('is-dragging');
        step(0);
      }
    });
    track.addEventListener('dragstart', (e) => e.preventDefault());
  }
</script>

<style>
  .car {
    --h: clamp(300px, 40vw, 560px);
    --edge: max(var(--gutter), (100% - var(--max)) / 2);
  }

  .car__track {
    display: flex;
    gap: 12px;
    padding-inline: var(--edge);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--edge);
    scrollbar-width: none;
    cursor: grab;
    overscroll-behavior-x: contain;
  }

  .car__track::-webkit-scrollbar {
    display: none;
  }

  .car__track.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    user-select: none;
  }

  .car__track:focus-visible {
    outline-offset: -4px;
  }

  .car__item {
    --p: 0;
    position: relative;
    flex: none;
    height: var(--h);
    aspect-ratio: var(--ar);
    max-width: 86vw;
    margin: 0;
    overflow: hidden;
    scroll-snap-align: start;
    background: #1b1d21;
  }

  .car__item :global(picture),
  .car__item :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Paralaje: la foto se mueve un poco dentro del marco al desplazar el carrusel */
  .car__item :global(img) {
    transform: translateX(calc(var(--p) * -6%)) scale(1.12);
    will-change: transform;
  }

  .car__item figcaption {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 8px 14px;
    background: var(--ink);
    color: #fff;
    font-family: var(--f-display);
    font-stretch: 125%;
    font-weight: 700;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .car__ui {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-top: 24px;
  }

  .car__bar {
    flex: 1;
    height: 2px;
    background: var(--line, rgb(18 20 23 / 0.12));
  }

  .car__bar span {
    display: block;
    height: 100%;
    background: var(--ink);
    transform-origin: 0 50%;
    transform: scaleX(0.08);
  }

  .car__btns {
    display: flex;
    gap: 8px;
  }

  .car__btn {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1.5px solid var(--ink);
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }

  .car__btn:hover {
    background: var(--ink);
    color: #fff;
  }

  .car__btn svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (prefers-reduced-motion: reduce) {
    .car__item :global(img) {
      transform: none;
    }
  }
</style>
