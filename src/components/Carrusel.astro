---
/**
 * Carrusel horizontal de fotos a sangre.
 * Avanza solo (se pausa al interactuar o fuera de pantalla), se arrastra con ratón o dedo,
 * destaca la foto activa con un zoom lento y mueve un poco cada foto dentro de su marco (paralaje).
 */
import type { ImageMetadata } from 'astro';
import Foto from './Foto.astro';

interface Item {
  img: ImageMetadata;
  alt: string;
  caption: string;
}
interface Props {
  items: Item[];
  label: string;
  interval?: number;
  class?: string;
}

const { items, label, interval = 5000, class: className } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<div class:list={['car', className]} data-carrusel data-interval={interval} style={`--interval:${interval}ms`}>
  <div class="car__track" tabindex="0" role="region" aria-roledescription="carrusel" aria-label={label}>
    {
      items.map((it, i) => (
        <figure class="car__item" style={`--ar:${(it.img.width / it.img.height).toFixed(3)}`} aria-label={`${i + 1} de ${items.length}`}>
          <div class="car__zoom">
            <Foto src={it.img} alt={it.alt} sizes="(min-width: 900px) 60vw, 90vw" widths={[640, 960, 1280]} />
          </div>
          <figcaption>
            <span class="car__n">{pad(i + 1)}</span>
            {it.caption}
          </figcaption>
        </figure>
      ))
    }
  </div>
  <div class="container car__ui">
    <p class="car__count" aria-live="polite">
      <strong data-current>01</strong> / {pad(items.length)}
    </p>
    <div class="car__bar" aria-hidden="true"><span></span></div>
    <div class="car__btns">
      <button type="button" class="car__btn" data-dir="-1" aria-label="Foto anterior">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M19 12H6M11 6.5 5.5 12 11 17.5"></path></svg>
      </button>
      <button type="button" class="car__btn" data-dir="1" aria-label="Foto siguiente">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12h13M13 6.5 18.5 12 13 17.5"></path></svg>
      </button>
    </div>
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-carrusel]')) {
    const track = root.querySelector<HTMLElement>('.car__track')!;
    const bar = root.querySelector<HTMLElement>('.car__bar span')!;
    const counter = root.querySelector<HTMLElement>('[data-current]')!;
    const items = [...track.querySelectorAll<HTMLElement>('.car__item')];
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const interval = Number(root.dataset.interval) || 5000;
    const pos = (it: HTMLElement) => it.offsetLeft - items[0].offsetLeft;

    let active = -1;
    const setActive = (i: number) => {
      if (i === active) return;
      items[active]?.classList.remove('is-active');
      active = i;
      items[i].classList.add('is-active');
      counter.textContent = String(i + 1).padStart(2, '0');
      restartTimer();
    };

    const nearest = () => {
      const left = track.scrollLeft;
      const atEnd = left >= track.scrollWidth - track.clientWidth - 2;
      if (atEnd) return items.length - 1;
      let best = 0;
      items.forEach((it, i) => {
        if (Math.abs(pos(it) - left) < Math.abs(pos(items[best]) - left)) best = i;
      });
      return best;
    };

    let ticking = false;
    const update = () => {
      ticking = false;
      const max = track.scrollWidth - track.clientWidth;
      bar.style.transform = `scaleX(${max > 0 ? Math.max(0.04, track.scrollLeft / max) : 1})`;
      setActive(nearest());
      if (reduced) return;
      const mid = innerWidth / 2;
      for (const it of items) {
        const r = it.getBoundingClientRect();
        if (r.right < 0 || r.left > innerWidth) continue;
        it.style.setProperty('--p', ((r.left + r.width / 2 - mid) / innerWidth).toFixed(3));
      }
    };
    const request = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    track.addEventListener('scroll', request, { passive: true });
    addEventListener('resize', request);

    const go = (i: number) => {
      const target = (i + items.length) % items.length;
      track.scrollTo({ left: pos(items[target]), behavior: reduced ? 'auto' : 'smooth' });
    };
    const step = (dir: number) => go(nearest() + dir);

    /* ---------- Avance automático ---------- */
    let timer = 0;
    let visible = false;
    let paused = false;
    let resumeAt = 0;

    function restartTimer() {
      clearTimeout(timer);
      root.classList.remove('is-timing');
      if (reduced || !visible || paused || document.hidden) return;
      void root.offsetWidth;
      root.classList.add('is-timing');
      timer = window.setTimeout(() => step(1), interval);
    }

    const pause = (ms = 0) => {
      paused = true;
      clearTimeout(timer);
      clearTimeout(resumeAt);
      root.classList.remove('is-timing');
      if (ms) resumeAt = window.setTimeout(() => ((paused = false), restartTimer()), ms);
    };
    const resume = () => {
      paused = false;
      restartTimer();
    };

    new IntersectionObserver(
      ([e]) => {
        visible = e.isIntersecting;
        restartTimer();
      },
      { threshold: 0.35 }
    ).observe(root);
    document.addEventListener('visibilitychange', restartTimer);
    root.addEventListener('mouseenter', () => pause());
    root.addEventListener('mouseleave', resume);
    root.addEventListener('focusin', () => pause());
    root.addEventListener('focusout', resume);
    track.addEventListener('touchstart', () => pause(8000), { passive: true });

    root.querySelectorAll<HTMLButtonElement>('.car__btn').forEach((b) =>
      b.addEventListener('click', () => step(Number(b.dataset.dir)))
    );
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        e.preventDefault();
        step(e.key === 'ArrowRight' ? 1 : -1);
      }
    });

    /* ---------- Arrastre con ratón (en táctil ya lo hace el navegador) ---------- */
    let startX = 0;
    let startLeft = 0;
    let startIndex = 0;
    let dragging = false;
    let moved = false;
    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      dragging = true;
      moved = false;
      startX = e.clientX;
      startLeft = track.scrollLeft;
      startIndex = active;
    });
    addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - startX;
      if (!moved && Math.abs(dx) > 4) {
        moved = true;
        track.classList.add('is-dragging');
      }
      if (moved) track.scrollLeft = startLeft - dx;
    });
    addEventListener('pointerup', (e) => {
      if (!dragging) return;
      dragging = false;
      if (!moved) return;
      track.classList.remove('is-dragging');
      const dx = e.clientX - startX;
      // Basta un arrastre corto para pasar de foto; si no llega, vuelve a la de antes
      const target = Math.abs(dx) > 60 ? startIndex + (dx < 0 ? 1 : -1) : startIndex;
      go(Math.min(items.length - 1, Math.max(0, target)));
    });
    track.addEventListener('dragstart', (e) => e.preventDefault());

    update();
  }
</script>

<style>
  .car {
    --h: clamp(300px, 40vw, 580px);
    --edge: max(var(--gutter), (100% - var(--max)) / 2);
  }

  .car__track {
    display: flex;
    gap: 12px;
    padding-inline: var(--edge);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--edge);
    scrollbar-width: none;
    cursor: grab;
    overscroll-behavior-x: contain;
  }

  .car__track::-webkit-scrollbar {
    display: none;
  }

  .car__track.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    user-select: none;
  }

  .car__track:focus-visible {
    outline-offset: -4px;
  }

  .car__item {
    --p: 0;
    position: relative;
    flex: none;
    height: var(--h);
    aspect-ratio: var(--ar);
    max-width: 86vw;
    margin: 0;
    overflow: hidden;
    scroll-snap-align: start;
    background: #1b1d21;
  }

  /* Las que no están activas quedan un poco apagadas */
  .car__item::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(10 12 15 / 0.38);
    transition: opacity 0.7s var(--ease-out);
    pointer-events: none;
  }

  .car__item.is-active::after {
    opacity: 0;
  }

  .car__zoom,
  .car__zoom :global(picture),
  .car__zoom :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .car__zoom :global(img) {
    object-fit: cover;
    transform: translateX(calc(var(--p) * -6%)) scale(1.12);
    will-change: transform;
  }

  /* Zoom lento sobre la foto activa */
  .car__zoom {
    transition: transform 1.2s var(--ease-out);
  }

  .car__item.is-active .car__zoom {
    animation: kenburns calc(var(--interval) + 2s) linear both;
  }

  @keyframes kenburns {
    from { transform: scale(1); }
    to { transform: scale(1.07); }
  }

  .car__item figcaption {
    position: absolute;
    left: 0;
    bottom: 0;
    z-index: 1;
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 10px 16px;
    background: var(--ink);
    color: #fff;
    font-family: var(--f-display);
    font-stretch: 125%;
    font-weight: 700;
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transform: translateY(0);
    transition: transform 0.6s var(--ease-out);
  }

  .car__n {
    color: #7fc0ec;
  }

  .car__item:not(.is-active) figcaption {
    transform: translateY(100%);
  }

  .car__ui {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 24px;
  }

  .car__count {
    min-width: 5.5ch;
    color: var(--ink-3);
    font-family: var(--f-display);
    font-stretch: 125%;
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
  }

  .car__count strong {
    color: var(--ink);
  }

  /* Barra: el tramo oscuro es el recorrido; la línea azul, el tiempo hasta la siguiente foto */
  .car__bar {
    position: relative;
    flex: 1;
    height: 2px;
    background: var(--line, rgb(18 20 23 / 0.12));
  }

  .car__bar span {
    display: block;
    height: 100%;
    background: var(--ink);
    transform-origin: 0 50%;
    transform: scaleX(0.04);
    transition: transform 0.4s var(--ease-out);
  }

  .car__bar::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -1px;
    height: 4px;
    background: var(--blue-deep);
    transform-origin: 0 50%;
    transform: scaleX(0);
    opacity: 0;
  }

  .car.is-timing .car__bar::after {
    opacity: 1;
    animation: timer var(--interval) linear both;
  }

  @keyframes timer {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  .car__btns {
    display: flex;
    gap: 8px;
  }

  .car__btn {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1.5px solid var(--ink);
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }

  .car__btn:hover {
    background: var(--ink);
    color: #fff;
  }

  .car__btn svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (prefers-reduced-motion: reduce) {
    .car__zoom :global(img) {
      transform: none;
    }
    .car__item.is-active .car__zoom {
      animation: none;
    }
  }
</style>
