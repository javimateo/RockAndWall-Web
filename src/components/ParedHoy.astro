---
/**
 * "La pared hoy": las vías y bloques montados, con su reparto por grado o color,
 * buscador y filtros. Parecido al widget de Vertical-Life que usa Sharma Climbing,
 * pero integrado en la web. Se pinta en el navegador a partir de src/data/pared.ts.
 */
import { lineas, ordenColores, ordenGrados, paredEsEjemplo } from '../data/pared';

interface Props {
  id?: string;
  class?: string;
}

const { id = 'pared', class: className } = Astro.props;
const data = JSON.stringify({ lineas, ordenGrados, ordenColores });
---

<section class:list={['ph', className]} id={id} data-pared data-json={data}>
  <div class="container">
    <slot />

    <div class="ph__panel">
      <div class="ph__top">
        <div class="ph__tabs" role="tablist" aria-label="Tipo de escalada">
          <button type="button" role="tab" class="ph__tab" data-tipo="via" aria-selected="true">
            Vías <span data-count="via"></span>
          </button>
          <button type="button" role="tab" class="ph__tab" data-tipo="bloque" aria-selected="false">
            Bloques <span data-count="bloque"></span>
          </button>
        </div>
        <dl class="ph__stats">
          <div><dt>Nuevos esta semana</dt><dd data-stat="nuevos">–</dd></div>
          <div><dt>Última renovación</dt><dd data-stat="ultima">–</dd></div>
          <div><dt>Equipadores</dt><dd data-stat="equipadores">–</dd></div>
        </dl>
      </div>

      <div class="ph__chart" role="group" aria-label="Reparto por grado. Pulsa una barra para filtrar"></div>

      <div class="ph__controls">
        <label class="ph__search">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4.5 4.5"></path></svg>
          <span class="visually-hidden">Buscar</span>
          <input type="search" placeholder="Busca por grado, color, zona o equipador" autocomplete="off" />
        </label>
        <div class="ph__zones" role="group" aria-label="Filtrar por zona"></div>
      </div>

      <p class="ph__result" aria-live="polite"></p>
      <ol class="ph__list"></ol>
      <button type="button" class="ph__more" hidden>Ver más</button>
    </div>

    {paredEsEjemplo && <p class="ph__note">Datos de ejemplo para la demo. En la web real se actualizaría desde una hoja de cálculo de los equipadores o desde una app como Vertical-Life.</p>}
  </div>
</section>

<script>
  interface Linea {
    tipo: 'via' | 'bloque';
    n: string;
    color: string;
    colorLabel: string;
    grado: string;
    zona: string;
    equipador: string;
    dias: number;
    encadenes: number;
  }

  const hex: Record<string, string> = {
    green: '#45bf4b',
    blue: '#2f7fe0',
    yellow: '#ffd23a',
    orange: '#ff7a1a',
    pink: '#ff4f9a',
    red: '#e5352b',
    black: '#1b1c1f',
    white: '#f4f3ee',
    purple: '#7b4fd6',
  };
  const PAGE = 12;
  const norm = (s: string) => s.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase();
  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) => {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text !== undefined) n.textContent = text;
    return n;
  };

  for (const root of document.querySelectorAll<HTMLElement>('[data-pared]')) {
    const { lineas, ordenGrados, ordenColores } = JSON.parse(root.dataset.json ?? '{}') as {
      lineas: Linea[];
      ordenGrados: string[];
      ordenColores: string[];
    };
    const chart = root.querySelector<HTMLElement>('.ph__chart')!;
    const list = root.querySelector<HTMLElement>('.ph__list')!;
    const zones = root.querySelector<HTMLElement>('.ph__zones')!;
    const result = root.querySelector<HTMLElement>('.ph__result')!;
    const more = root.querySelector<HTMLButtonElement>('.ph__more')!;
    const input = root.querySelector<HTMLInputElement>('.ph__search input')!;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.ph__tab')];

    const today = new Date();
    const fecha = (dias: number) => {
      const d = new Date(today);
      d.setDate(d.getDate() - dias);
      return d.toLocaleDateString('es-ES', { day: 'numeric', month: 'short' }).replace('.', '');
    };
    const hace = (dias: number) => (dias === 0 ? 'hoy' : dias === 1 ? 'ayer' : `hace ${dias} días`);

    for (const t of ['via', 'bloque'] as const) {
      root.querySelector(`[data-count="${t}"]`)!.textContent = String(lineas.filter((l) => l.tipo === t).length);
    }

    let tipo: 'via' | 'bloque' = 'via';
    let zona = '';
    let grado = '';
    let query = '';
    let shown = PAGE;

    const base = () => lineas.filter((l) => l.tipo === tipo);
    const filtered = () =>
      base().filter(
        (l) =>
          (!zona || l.zona === zona) &&
          (!grado || l.grado === grado) &&
          (!query ||
            norm(`${l.n} ${l.grado} ${l.colorLabel} ${l.zona} ${l.equipador} ${l.dias < 8 ? 'nuevo' : ''}`).includes(query))
      );

    const renderStats = () => {
      const b = base();
      root.querySelector('[data-stat="nuevos"]')!.textContent = String(b.filter((l) => l.dias < 8).length);
      root.querySelector('[data-stat="ultima"]')!.textContent = hace(Math.min(...b.map((l) => l.dias)));
      root.querySelector('[data-stat="equipadores"]')!.textContent = String(new Set(b.map((l) => l.equipador)).size);
    };

    const renderChart = () => {
      const order = tipo === 'via' ? ordenGrados : ordenColores;
      const b = base().filter((l) => !zona || l.zona === zona);
      const counts = order.map((g) => b.filter((l) => l.grado === g).length);
      const max = Math.max(1, ...counts);
      chart.setAttribute('aria-label', `Reparto por ${tipo === 'via' ? 'grado' : 'color'}. Pulsa una barra para filtrar`);
      chart.replaceChildren(
        ...order.map((g, i) => {
          const btn = el('button', 'ph__bar');
          btn.type = 'button';
          btn.dataset.grado = g;
          btn.setAttribute('aria-pressed', String(grado === g));
          btn.setAttribute('aria-label', `${g}: ${counts[i]}`);
          if (grado && grado !== g) btn.classList.add('is-dim');
          const col = tipo === 'bloque' ? hex[b.find((l) => l.grado === g)?.color ?? ''] : '';
          btn.style.setProperty('--h', String(counts[i] / max));
          btn.style.setProperty('--i', String(i));
          if (col) btn.style.setProperty('--c', col);
          btn.append(el('span', 'ph__n', String(counts[i])), el('span', 'ph__fill'), el('span', 'ph__label', g));
          return btn;
        })
      );
    };

    const renderZones = () => {
      const all = [...new Set(base().map((l) => l.zona))].sort();
      zones.replaceChildren(
        ...['', ...all].map((z) => {
          const b = el('button', 'ph__zone', z || 'Todas');
          b.type = 'button';
          b.dataset.zona = z;
          b.setAttribute('aria-pressed', String(zona === z));
          return b;
        })
      );
    };

    const renderList = () => {
      const items = filtered();
      const parts = [
        `${items.length} ${tipo === 'via' ? (items.length === 1 ? 'vía' : 'vías') : items.length === 1 ? 'bloque' : 'bloques'}`,
      ];
      if (grado) parts.push(tipo === 'via' ? `de ${grado}` : `${grado.toLowerCase()}s`);
      if (zona) parts.push(`en ${zona}`);
      result.textContent = parts.join(' ');
      list.replaceChildren(
        ...(items.length
          ? items.slice(0, shown).map((l) => {
              const li = el('li', 'ph__row');
              li.style.setProperty('--c', hex[l.color] ?? '#999');
              const n = el('span', 'ph__num', l.n);
              const sw = el('span', 'ph__sw');
              sw.setAttribute('aria-label', l.colorLabel);
              const g = el('strong', 'ph__grade', tipo === 'via' ? l.grado : l.colorLabel);
              const info = el('span', 'ph__info');
              info.append(
                el('span', 'ph__zona', l.zona),
                el('span', 'ph__by', `${tipo === 'via' ? `Cinta ${l.colorLabel.toLowerCase()} · ` : ''}Equipa ${l.equipador}`)
              );
              const when = el('span', 'ph__when', `${fecha(l.dias)} · ${hace(l.dias)}`);
              const tops = el('span', 'ph__tops', `${l.encadenes} encadenes`);
              li.append(n, sw, g, info, when, tops);
              if (l.dias < 8) li.append(el('span', 'ph__new', 'Nuevo'));
              return li;
            })
          : [el('li', 'ph__empty', 'No hay nada que coincida. Prueba con otra búsqueda.')])
      );
      more.hidden = items.length <= shown;
      more.textContent = `Ver más (${items.length - shown})`;
    };

    const render = () => {
      renderStats();
      renderChart();
      renderZones();
      renderList();
    };

    tabs.forEach((t) =>
      t.addEventListener('click', () => {
        tipo = t.dataset.tipo as 'via' | 'bloque';
        zona = '';
        grado = '';
        shown = PAGE;
        tabs.forEach((o) => o.setAttribute('aria-selected', String(o === t)));
        render();
      })
    );

    chart.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.ph__bar');
      if (!b) return;
      grado = grado === b.dataset.grado ? '' : b.dataset.grado!;
      shown = PAGE;
      renderChart();
      renderList();
    });

    zones.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.ph__zone');
      if (!b) return;
      zona = b.dataset.zona ?? '';
      shown = PAGE;
      renderChart();
      renderZones();
      renderList();
    });

    let t = 0;
    input.addEventListener('input', () => {
      clearTimeout(t);
      t = window.setTimeout(() => {
        query = norm(input.value.trim());
        shown = PAGE;
        renderList();
      }, 120);
    });

    more.addEventListener('click', () => {
      shown += PAGE;
      renderList();
    });

    render();
  }
</script>

<style is:global>
  .ph {
    --ph-bg: var(--ink, #121417);
    --ph-panel: #1a1d22;
    --ph-line: rgb(255 255 255 / 0.1);
    --ph-muted: #9aa3ae;
    --ph-accent: #7fc0ec;
    padding-block: clamp(80px, 10vw, 150px);
    background: var(--ph-bg);
    color: #fff;
  }

  .ph__panel {
    display: grid;
    gap: 24px;
    padding: clamp(20px, 3vw, 36px);
    border: 1px solid var(--ph-line);
    background: var(--ph-panel);
  }

  .ph__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
  }

  .ph__tabs {
    display: flex;
    gap: 4px;
    padding: 4px;
    background: rgb(255 255 255 / 0.06);
  }

  .ph__tab {
    padding: 12px 22px;
    border: 0;
    background: transparent;
    color: var(--ph-muted);
    font-family: var(--f-display);
    font-stretch: 115%;
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .ph__tab span {
    margin-left: 6px;
    opacity: 0.7;
  }

  .ph__tab[aria-selected='true'] {
    background: #fff;
    color: var(--ink, #121417);
  }

  .ph__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 36px;
    margin: 0;
  }

  .ph__stats dt {
    color: var(--ph-muted);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ph__stats dd {
    margin: 2px 0 0;
    font-family: var(--f-display);
    font-stretch: 72%;
    font-weight: 800;
    font-size: 1.9rem;
    line-height: 1;
  }

  /* ---------- Gráfico ---------- */
  .ph__chart {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    gap: 6px;
    align-items: end;
    height: 220px;
    padding-top: 8px;
    border-bottom: 1px solid var(--ph-line);
  }

  .ph__bar {
    --c: var(--ph-accent);
    display: grid;
    grid-template-rows: auto 1fr;
    align-items: end;
    height: 100%;
    padding: 0 0 26px;
    border: 0;
    background: transparent;
    color: #fff;
    font: inherit;
    cursor: pointer;
    position: relative;
    transition: opacity 0.25s;
  }

  .ph__bar.is-dim {
    opacity: 0.3;
  }

  .ph__fill {
    display: block;
    height: calc(var(--h) * 100%);
    min-height: 3px;
    background: var(--c);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.15);
    transform-origin: 50% 100%;
    animation: ph-grow 0.7s var(--ease-out) both;
    animation-delay: calc(var(--i) * 30ms);
  }

  .ph__bar:hover .ph__fill,
  .ph__bar[aria-pressed='true'] .ph__fill {
    box-shadow: inset 0 0 0 2px #fff;
  }

  @keyframes ph-grow {
    from { transform: scaleY(0); }
  }

  .ph__n {
    margin-bottom: 6px;
    color: var(--ph-muted);
    font-size: 0.78rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .ph__label {
    position: absolute;
    left: 50%;
    bottom: 4px;
    translate: -50% 0;
    overflow: hidden;
    max-width: 100%;
    color: var(--ph-muted);
    font-size: 0.72rem;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ---------- Controles ---------- */
  .ph__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 20px;
  }

  .ph__search {
    display: flex;
    flex: 1 1 280px;
    align-items: center;
    gap: 10px;
    padding: 0 14px;
    border: 1px solid var(--ph-line);
    background: rgb(255 255 255 / 0.04);
  }

  .ph__search:focus-within {
    border-color: var(--ph-accent);
  }

  .ph__search svg {
    flex: none;
    fill: none;
    stroke: var(--ph-muted);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .ph__search input {
    flex: 1;
    min-width: 0;
    padding: 13px 0;
    border: 0;
    outline: none;
    background: transparent;
    color: #fff;
    font: inherit;
    font-size: 0.95rem;
  }

  .ph__search input::placeholder {
    color: var(--ph-muted);
  }

  .ph__zones {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .ph__zone {
    padding: 8px 12px;
    border: 1px solid var(--ph-line);
    background: transparent;
    color: #d6dbe2;
    font: inherit;
    font-size: 0.82rem;
    cursor: pointer;
  }

  .ph__zone[aria-pressed='true'] {
    border-color: #fff;
    background: #fff;
    color: var(--ink, #121417);
  }

  /* ---------- Lista ---------- */
  .ph__result {
    color: var(--ph-muted);
    font-size: 0.9rem;
  }

  .ph__list {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ph__row {
    display: grid;
    grid-template-columns: 3.4ch 22px 5ch minmax(0, 1fr) auto auto auto;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    background: rgb(255 255 255 / 0.04);
    animation: ph-in 0.35s var(--ease-out) both;
  }

  @keyframes ph-in {
    from { opacity: 0; transform: translateY(6px); }
  }

  .ph__num {
    color: var(--ph-muted);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }

  .ph__sw {
    width: 22px;
    height: 22px;
    border-radius: 42% 58% 50% 50% / 60% 46% 54% 40%;
    background: var(--c);
    box-shadow: inset 0 -3px 0 rgb(0 0 0 / 0.2), 0 0 0 1px rgb(255 255 255 / 0.2);
  }

  .ph__grade {
    font-family: var(--f-display);
    font-stretch: 72%;
    font-weight: 800;
    font-size: 1.25rem;
    white-space: nowrap;
  }

  .ph__info {
    display: grid;
    min-width: 0;
  }

  .ph__zona {
    font-weight: 600;
  }

  .ph__by,
  .ph__when,
  .ph__tops {
    color: var(--ph-muted);
    font-size: 0.82rem;
  }

  .ph__by {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ph__when,
  .ph__tops {
    white-space: nowrap;
  }

  .ph__new {
    padding: 4px 8px;
    background: var(--h-yellow, #ffd23a);
    color: var(--ink, #121417);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ph__row:not(:has(.ph__new))::after {
    content: '';
    width: 1px;
  }

  .ph__empty {
    padding: 20px;
    color: var(--ph-muted);
  }

  .ph__more {
    justify-self: center;
    padding: 12px 22px;
    border: 1px solid rgb(255 255 255 / 0.3);
    background: transparent;
    color: #fff;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .ph__more:hover {
    background: #fff;
    color: var(--ink, #121417);
  }

  .ph__note {
    margin-top: 18px;
    color: var(--ph-muted);
    font-size: 0.8rem;
  }

  @media (max-width: 760px) {
    .ph__row {
      grid-template-columns: 22px auto minmax(0, 1fr) auto;
      grid-template-areas:
        'sw grade info new'
        'sw grade when when';
      gap: 2px 12px;
    }
    .ph__num,
    .ph__tops {
      display: none;
    }
    .ph__sw { grid-area: sw; }
    .ph__grade { grid-area: grade; }
    .ph__info { grid-area: info; }
    .ph__when { grid-area: when; }
    .ph__new { grid-area: new; justify-self: end; }
    .ph__chart {
      height: 180px;
      gap: 3px;
    }
    .ph__label {
      font-size: 0.62rem;
      writing-mode: vertical-rl;
      rotate: 180deg;
      translate: -50% 0;
      bottom: 2px;
    }
    .ph__bar {
      padding-bottom: 40px;
    }
    .ph__n {
      font-size: 0.66rem;
    }
  }
</style>
