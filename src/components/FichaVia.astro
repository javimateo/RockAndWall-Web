---
/**
 * Ficha de vía: la plaquita atornillada a pie de vía con número, grado y nombre.
 * Aquí cada tarifa es una vía: cuanto más compromiso, más grado.
 */
import Cinta from './Cinta.astro';
import Presa from './Presa.astro';

interface Props {
  n: string;
  grade: string;
  color: 'white' | 'green' | 'yellow' | 'blue' | 'orange' | 'red' | 'purple' | 'black' | 'pink';
  name: string;
  price: string;
  unit?: string;
  desc: string;
  items: readonly string[];
  note?: string;
  featured?: boolean;
  badge?: string;
  cta: { href: string; label: string };
  rot?: number;
}

const { n, grade, color, name, price, unit, desc, items, note, featured = false, badge, cta, rot = 0 } = Astro.props;
---

<article class:list={['ficha', { 'ficha--featured': featured }]} data-color={color} style={`--rot:${rot}deg`}>
  <span class="ficha__screw ficha__screw--l" aria-hidden="true"></span>
  <span class="ficha__screw ficha__screw--r" aria-hidden="true"></span>
  {badge && <Cinta class="ficha__badge" color="yellow" rot={5} size="sm">{badge}</Cinta>}

  <header class="ficha__head">
    <span class="ficha__n">Vía {n}</span>
    <Cinta color={color} size="lg" rot={-4} class="ficha__grade">{grade}</Cinta>
  </header>

  <h3 class="ficha__name">{name}</h3>
  <p class="ficha__price">
    <span class="ficha__amount">{price}</span><span class="ficha__eur">€</span>
    {unit && <span class="ficha__unit">{unit}</span>}
  </p>
  <p class="ficha__desc">{desc}</p>

  <ul class="ficha__items">
    {items.map((it) => <li>{it}</li>)}
  </ul>

  {note && <p class="ficha__note">{note}</p>}

  <div class="ficha__cta">
    <Presa href={cta.href} color={featured ? 'ink' : 'orange'} shape="crimp" rot={-1.5}>{cta.label}</Presa>
  </div>

  <footer class="ficha__meta">
    <span>Equipa: Rock &amp; Wall</span>
    <span>Temp. 2026</span>
  </footer>
</article>

<style>
  .ficha {
    --plate: #fbfbf7;
    --route: var(--h-white);
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 34px 26px 18px;
    border-radius: 7px;
    background:
      linear-gradient(160deg, rgb(255 255 255 / 0.7), transparent 38%),
      var(--plate);
    box-shadow:
      0 1px 0 rgb(0 0 0 / 0.04),
      0 2px 0 rgb(0 0 0 / 0.06),
      0 22px 40px -26px rgb(10 12 16 / 0.55);
    transform: rotate(var(--rot));
    transition: transform 0.5s var(--ease-spring), box-shadow 0.4s var(--ease-out);
  }

  /* La franja lateral es la cinta del color de la vía */
  .ficha::before {
    content: '';
    position: absolute;
    left: 0;
    top: 18px;
    bottom: 18px;
    width: 6px;
    border-radius: 0 3px 3px 0;
    background: var(--route);
  }

  .ficha[data-color='green'] { --route: var(--h-green); }
  .ficha[data-color='yellow'] { --route: var(--h-yellow); }
  .ficha[data-color='blue'] { --route: var(--h-blue); }
  .ficha[data-color='orange'] { --route: var(--h-orange); }
  .ficha[data-color='red'] { --route: var(--h-red); }
  .ficha[data-color='purple'] { --route: var(--h-purple); }
  .ficha[data-color='black'] { --route: var(--h-black); }
  .ficha[data-color='pink'] { --route: var(--h-pink); }
  .ficha[data-color='white'] { --route: #c9cbc4; }

  .ficha--featured {
    --plate: var(--orange);
    background:
      linear-gradient(160deg, rgb(255 255 255 / 0.28), transparent 42%),
      var(--logo-grad);
    color: var(--ink);
  }

  .ficha--featured::before {
    background: var(--ink);
  }

  @media (hover: hover) {
    .ficha:hover {
      transform: rotate(0deg) translateY(-4px);
      box-shadow:
        0 1px 0 rgb(0 0 0 / 0.04),
        0 2px 0 rgb(0 0 0 / 0.06),
        0 30px 50px -28px rgb(10 12 16 / 0.6);
    }
  }

  .ficha__screw {
    position: absolute;
    top: 12px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background:
      linear-gradient(45deg, transparent 44%, #6a6e73 44% 56%, transparent 56%),
      linear-gradient(-45deg, transparent 44%, #6a6e73 44% 56%, transparent 56%),
      radial-gradient(circle at 35% 35%, #f2f3f3, #a9adb1 70%);
    box-shadow: 0 1px 1px rgb(0 0 0 / 0.35);
  }

  .ficha__screw--l { left: 14px; }
  .ficha__screw--r { right: 14px; }

  :global(.ficha__badge) {
    position: absolute;
    top: -14px;
    right: 22px;
  }

  .ficha__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 18px;
  }

  .ficha__n {
    font-family: var(--f-display);
    font-stretch: 100%;
    font-weight: 700;
    font-size: 0.74rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  :global(.ficha__grade) {
    font-size: 1.9rem !important;
    padding: 0.28em 0.7em 0.2em !important;
  }

  .ficha__name {
    font-family: var(--f-display);
    font-stretch: 70%;
    font-weight: 850;
    font-size: clamp(1.7rem, 1.3rem + 1vw, 2.2rem);
    line-height: 0.92;
    text-transform: uppercase;
  }

  .ficha__price {
    display: flex;
    align-items: flex-start;
    margin: 14px 0 12px;
    font-family: var(--f-display);
    font-stretch: 62%;
    font-weight: 900;
    line-height: 0.8;
  }

  .ficha__amount {
    font-size: clamp(4.2rem, 3.4rem + 2.6vw, 5.6rem);
    letter-spacing: -0.02em;
  }

  .ficha__eur {
    margin: 0.12em 0 0 0.05em;
    font-size: 1.9rem;
  }

  .ficha__unit {
    align-self: flex-end;
    margin: 0 0 0.35em 0.5em;
    font-family: var(--f-body);
    font-stretch: 100%;
    font-weight: 500;
    font-size: 0.95rem;
    opacity: 0.7;
  }

  .ficha__desc {
    font-size: 0.98rem;
    line-height: 1.45;
    opacity: 0.85;
    text-wrap: pretty;
  }

  .ficha__items {
    display: grid;
    gap: 8px;
    margin: 18px 0 0;
    padding: 16px 0 0;
    border-top: 1.5px dashed rgb(0 0 0 / 0.15);
    list-style: none;
    font-size: 0.93rem;
  }

  .ficha__items li {
    display: flex;
    gap: 10px;
    align-items: baseline;
  }

  /* Viñeta: una presita del color de la vía */
  .ficha__items li::before {
    content: '';
    flex: none;
    width: 10px;
    height: 8px;
    translate: 0 -1px;
    border-radius: 45% 55% 60% 40% / 60% 50% 50% 40%;
    background: var(--route);
    box-shadow: inset 0 -2px 0 rgb(0 0 0 / 0.18);
  }

  .ficha--featured .ficha__items li::before {
    background: var(--ink);
  }

  .ficha__note {
    margin-top: 12px;
    font-size: 0.8rem;
    opacity: 0.65;
  }

  .ficha__cta {
    margin-top: auto;
    padding-top: 26px;
  }

  .ficha__meta {
    display: flex;
    justify-content: space-between;
    margin-top: 22px;
    padding-top: 12px;
    border-top: 1px solid rgb(0 0 0 / 0.08);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.55;
  }
</style>
