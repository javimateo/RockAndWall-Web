---
import '../styles/base.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Rock & Wall Climbing · Rocódromo en Sevilla',
  description = 'El mayor rocódromo de Andalucía está en Sevilla. Más de 500 m² de bloque, más de 80 vías, Moon Board, Kilter Board y el mejor tardeo.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eeefeb" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      // Las animaciones de entrada esperan a la tipografía para no saltar al cambiar de fuente
      (function (c) {
        c.add('js');
        var ready = function () {
          requestAnimationFrame(function () {
            c.add('is-ready');
          });
        };
        if (document.fonts && document.fonts.load) document.fonts.load('900 1em "Archivo Variable"').then(ready, ready);
        setTimeout(ready, 1200);
      })(document.documentElement.classList);
    </script>
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/reveal';
      import '../scripts/videos';
    </script>
  </body>
</html>
